{
    "name": "atoolo/translation-api-bundle",
    "description": "Symfony bundle that exposes translation catalogues as JSON over HTTP, e.g. for i18next.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "translation",
        "i18next",
        "icu",
        "api"
    ],
    "authors": [
        {
            "name": "Felix Becker",
            "email": "becker@sitepark.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6.0",
        "ext-intl": "*",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "nelmio/cors-bundle": "^2.6",
        "overtrue/phplint": "^9.7.2",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.13.5",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/security-bundle": "Required for full access to all locales and domains (full_access_role)"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Atoolo\\TranslationApi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoolo\\TranslationApi\\Dev\\": "dev/src",
            "Atoolo\\TranslationApi\\Test\\": "test"
        }
    },
    "archive": {
        "exclude": [
            "*",
            "!composer.json",
            "!config",
            "!src"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "post-install-cmd": "phive --no-progress install --trust-gpg-keys C00543248C87FB13,4AA394086372C20A,CF1A108D0E7AE720,51C67305FFC2E5C0,E82B2FB314E9906E",
        "analyse": [
            "@analyse:phplint",
            "@analyse:phpstan",
            "@analyse:phpcsfixer",
            "@analyse:compatibilitycheck"
        ],
        "analyse:compatibilitycheck": "./vendor/bin/phpcs --standard=./phpcs.compatibilitycheck.xml",
        "analyse:phpcsfixer": "./tools/php-cs-fixer check --diff --show-progress=dots",
        "analyse:phplint": "./vendor/bin/phplint",
        "analyse:phpstan": "./tools/phpstan analyse",
        "fix": [
            "@fix:phpcsfixer"
        ],
        "fix:phpcsfixer": "./tools/php-cs-fixer fix",
        "report": [
            "@report:phpstan"
        ],
        "report:phpstan": "./tools/phpstan analyse --no-progress --no-ansi --no-interaction --error-format=checkstyle > ./var/log/phpstan-report.xml || exit 0",
        "serve-dev": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t dev/public"
        ],
        "test": [
            "@test:phpunit"
        ],
        "test:phpunit": "./tools/phpunit.phar -c phpunit.xml --coverage-text"
    }
}
